{
  "version": "1.0",
  "entities": [
    { "id": "cedar-observatory", "name": "シダー天文台", "description": "公開観望会を準備する架空の地域天文台。" },
    { "id": "cedar-sky-club", "name": "シダー星空クラブ", "description": "公開観望会を企画するボランティアの会。" },
    { "id": "mira-vale", "name": "ミラ・ヴェイル", "description": "クラブのまとめ役。" },
    { "id": "ren-sato", "name": "レン・サトウ", "description": "天文台の技術担当。" },
    { "id": "bluebird-telescope", "name": "ブルーバード望遠鏡", "description": "来場者向けの星空案内に使う望遠鏡。" },
    { "id": "neighbors", "name": "地域の来場者", "description": "公開観望会に招かれた人々。" }
  ],
  "events": [
    {
      "id": "plan-approved",
      "name": "クラブが公開観望会を決める",
      "description": "ミラとクラブが、近所の人々をシダー天文台へ招くことを決める。",
      "extensions": { "history": { "time": { "year": 2026, "month": 5, "day": 14 } } }
    },
    {
      "id": "invitations-sent",
      "name": "招待状を送る",
      "description": "クラブは翌暦月に招待状を送る予定を立てる。正確な日はまだ記録されていない。"
    },
    {
      "id": "dome-ready",
      "name": "ドームを準備する",
      "description": "ボランティアが機材点検より前にドームを整える。日付はまだ分からない。"
    },
    {
      "id": "telescope-checked",
      "name": "望遠鏡を点検する",
      "description": "レンがドームの準備後、来場者を迎える前にブルーバードを点検する。日付はまだ分からない。"
    },
    {
      "id": "doors-open",
      "name": "天文台が来場者を迎える",
      "description": "地域の公開観望会が始まる。",
      "extensions": { "history": { "time": { "year": 2026, "month": 6, "day": 20, "hour": 18, "minute": 0 } } }
    },
    {
      "id": "sky-tour",
      "name": "最初の星空案内が始まる",
      "description": "開場から経過時間で2時間後に始める予定。時刻はまだ日時の記録として保存されていない。"
    },
    {
      "id": "open-night-ends",
      "name": "公開観望会を終える",
      "description": "夜のプログラムの後、ボランティアが天文台を閉める。",
      "extensions": { "history": { "time": { "year": 2026, "month": 6, "day": 20, "hour": 22, "minute": 0 } } }
    }
  ],
  "relations": [
    { "id": "club-uses-observatory", "sourceId": "cedar-sky-club", "targetId": "cedar-observatory", "name": "利用する" },
    { "id": "mira-coordinates-club", "sourceId": "mira-vale", "targetId": "cedar-sky-club", "name": "まとめ役を務める" },
    { "id": "ren-maintains-observatory", "sourceId": "ren-sato", "targetId": "cedar-observatory", "name": "保守する" },
