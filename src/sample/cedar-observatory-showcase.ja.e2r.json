    },
    {
      "id": "tour-two-hours-after-opening",
      "sourceId": "doors-open",
      "targetId": "sky-tour",
      "extensions": { "draft.github.sukoyaka-dopeness.relative-time": { "type": "elapsed-offset", "direction": "after", "value": 2, "unit": "hour" } }
