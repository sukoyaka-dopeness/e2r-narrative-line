  "events": [
    {
      "id": "plan-approved",
      "name": "クラブが公開観望会を決める",
      "description": "ミラとクラブが、近所の人々をシダー天文台へ招くことを決める。",
      "extensions": { "history": { "time": { "year": 2026, "month": 5, "day": 14 } } }
    },
    {
      "id": "volunteer-roles-assigned",
      "name": "ボランティアの担当を決める",
      "description": "クラブが受付、案内、機材点検の担当を割り振り、ミラが連絡役を務める。",
      "extensions": { "history": { "time": { "year": 2026, "month": 5, "day": 21 } } }
    },
    {
      "id": "invitations-sent",
      "name": "招待状を送る",
      "description": "クラブは翌暦月に招待状を送る予定を立てる。正確な日はまだ記録されていない。"
    },
    {
      "id": "visitor-route-drafted",
