      "extensions": { "history": { "time": { "year": 2026, "month": 6, "day": 20, "hour": 16, "minute": 0 } } }
    },
    {
      "id": "welcome-desk-ready",
      "name": "受付の準備が整う",
      "description": "案内板と来場者名簿を置き、開場前の受付を整える。",
      "extensions": { "history": { "time": { "year": 2026, "month": 6, "day": 20, "hour": 17, "minute": 15 } } }
    },
    {
      "id": "doors-open",
      "name": "天文台が来場者を迎える",
      "description": "地域の公開観望会が始まる。",
      "extensions": { "history": { "time": { "year": 2026, "month": 6, "day": 20, "hour": 18, "minute": 0 } } }
    },
    {
      "id": "sky-tour",
      "name": "最初の星空案内が始まる",
